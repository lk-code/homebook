@page "/Kitchen/Recipes/{RecipeId:guid}/Edit"
@page "/Kitchen/Recipes/New"

@using HomeBook.Frontend.Core.Icons
@using HomeBook.Frontend.Module.Kitchen.Contracts
@using HomeBook.Frontend.Module.Kitchen.ViewModels
@using HomeBook.Frontend.Module.Kitchen.Pages.Recipes.Components
@using HomeBook.Frontend.Module.Kitchen.Resources
@using HomeBook.Frontend.Modules.Abstractions
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Localization

@inject IRecipeService RecipeService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IStringLocalizer<Strings> Loc
@inject IFileStorageService FileStorageService
@inject IFileStorageRegistration FileStorageRegistration
@inject IMediaService MediaService

@if (!_isLoading
     && _recipe != null)
{
    <MudContainer>

        <MudPaper Class="frosted-b6 text-dark mb-5 pa-3 rounded-pill">

            <MudToolBar Dense="true"
                        Class="px-0">

                @if (RecipeId != Guid.Empty)
                {
                    <MudTooltip Color="Color.Primary"
                                Text="@Loc[nameof(Resources.Strings.RecipeEdit_ViewRecipeButton_Text)]">
                        <MudIconButton Icon="@HomeBookIcons.Icons8.Windows11.Outline.RestaurantMenu"
                                       Variant="Variant.Filled"
                                       Class="pa-3 rounded-pill"
                                       Href="@string.Format("/Kitchen/Recipes/{0}/View", RecipeId)"
                                       Color="Color.Primary"/>
                    </MudTooltip>
                }

                <MudSpacer/>

                @if (RecipeId == Guid.Empty)
                {
                    <MudTextField T="string"
                                  @bind-Value="@_recipe.Name"
                                  Placeholder="@Loc[nameof(Resources.Strings.RecipeEdit_RecipeNameEditTextField_Placeholder)]"/>
                }
                else if (!_nameEditMode)
                {
                    <MudText Typo="Typo.h5">
                        @_recipe.Name
                    </MudText>
                    <MudTooltip Color="Color.Primary"
                                Text="@Loc[nameof(Resources.Strings.RecipeEdit_RecipeNameEditToolTip_Text)]">
                        <MudIconButton Icon="@HomeBookIcons.Icons8.Windows11.Outline.Edit"
                                       Color="Color.Primary"
                                       OnClick="EditRecipeNameAsync"
                                       Class="ms-3"/>
                    </MudTooltip>
                }
                else
                {
                    <MudTextField T="string"
                                  @bind-Value="@_recipe.Name"/>
                    <MudTooltip Color="Color.Primary"
                                Text="@Loc[nameof(Resources.Strings.RecipeEdit_RecipeNameSaveTooltip_Text)]">
                        <MudIconButton Icon="@HomeBookIcons.Icons8.Windows11.Outline.Save"
                                       Color="Color.Primary"
                                       OnClick="UpdateRecipeNameAsync"
                                       Class="ms-3"/>
                    </MudTooltip>
                }

                <MudSpacer/>

                @if (RecipeId != Guid.Empty)
                {
                    <MudTooltip Color="Color.Error"
                                Text="@Loc[nameof(Resources.Strings.RecipeEdit_RecipeDeleteTooltip_Text)]">
                        <MudIconButton Icon="@HomeBookIcons.Icons8.Windows11.Outline.Trash"
                                       OnClick="DeleteRecipe"
                                       Color="Color.Error"/>
                    </MudTooltip>
                }

            </MudToolBar>

        </MudPaper>

        <MudPaper Class="frosted-b8 text-dark mb-5 pa-3">

            <MudTextField T="string"
                          @bind-Value="@_recipe.Description"
                          Label="@Loc[nameof(Resources.Strings.RecipeEdit_RecipeDescriptionTextField_Label)]"
                          Variant="Variant.Outlined"
                          Lines="5"/>

            <MudPaper Class="frosted-b1 text-dark mt-5 pa-3">

                <MudToolBar Dense="true"
                            Class="px-0">

                    @switch (_recipe.NumberOfServings)
                    {
                        case 1:
                            <MudText Typo="Typo.body1">
                                @Loc[nameof(Resources.Strings.RecipeEdit_ServingsLabel_Singular)]
                            </MudText>
                            break;
                        default:
                            <MudText Typo="Typo.body1">
                                @string.Format(Loc[nameof(Resources.Strings.RecipeEdit_ServingsLabel_Plural)], _recipe.NumberOfServings)
                            </MudText>
                            break;
                    }

                    <MudSpacer/>

                    <UiNumericGroup @bind-Value="@_recipe.NumberOfServings"
                                    Min="1"
                                    Max="int.MaxValue"
                                    Step="1"/>

                </MudToolBar>

            </MudPaper>


        </MudPaper>

        <MudPaper Class="frosted-b8 text-dark mb-5">

            <UiRecipeIngredientsList @bind-Ingredients="@_recipe.Ingredients"/>

        </MudPaper>

        <MudPaper Class="frosted-b8 text-dark mb-5">

            <UiRecipeStepsList @bind-Steps="@_recipe.Steps"/>

        </MudPaper>

        <MudPaper Class="frosted-b4 text-dark mb-5">

            <MudFileUpload T="IBrowserFile"
                           Accept="@_acceptedFileTypes"
                           AppendMultipleFiles="true"
                           MaximumFileCount="10"
                           MaxFileSize="@(50 * 1024 * 1024)"
                           OnFilesChanged="UploadRecipeImagesAsync"
                           DragAndDrop="true">
                <SelectedTemplate/>
            </MudFileUpload>

        </MudPaper>

        <MudPaper Class="frosted-b4 text-dark mb-5 pa-4">

            <MudText Typo="Typo.h6"
                     Class="mb-4">
                @Loc["RecipeEdit_ImageGallery_Title"]
            </MudText>

            <MudText Typo="Typo.body2"
                     Class="mb-4 mud-text-secondary">
                @Loc["RecipeEdit_ImageGallery_ReorderHint_Text"]
            </MudText>

            @if (_recipe.ImageMediaItems.Count == 0)
            {
                <MudText Typo="Typo.body2"
                         Class="mud-text-secondary">
                    @Loc["RecipeEdit_ImageGallery_EmptyState_Text"]
                </MudText>
            }
            else
            {
                <MudDropContainer T="MediaItemViewModel"
                                  @ref="_recipeImageDropContainer"
                                  Items="_recipe.ImageMediaItems"
                                  ItemsSelector="@((item, dropzone) => dropzone == RecipeImagesDropZoneIdentifier)"
                                  ItemDropped="OnRecipeImageDropped"
                                  DraggingClass="recipe-edit-image-drop-zone-dragging"
                                  ItemDraggingClass="recipe-edit-image-card-dragging">

                    <ChildContent>
                        <MudDropZone T="MediaItemViewModel"
                                     Identifier="@RecipeImagesDropZoneIdentifier"
                                     AllowReorder="true"
                                     Class="recipe-edit-image-drop-zone"/>
                    </ChildContent>

                    <ItemRenderer>

                        <div class="recipe-edit-image-card-slot"
                             @key="@($"{context.Id}:{context.Index}")">

                            <MudPaper Class="pa-3 rounded-lg recipe-edit-image-card"
                                      Style="background: linear-gradient(180deg, rgba(255,255,255,0.78) 0%, rgba(255,255,255,0.45) 100%);">
                                <div class="d-flex align-center justify-space-between mb-3 gap-3">
                                    <MudDragHandle T="MediaItemViewModel">
                                        <div class="recipe-edit-image-drag-handle">
                                            <MudIcon Icon="@Icons.Material.Filled.DragIndicator"
                                                     Color="Color.Primary"/>
                                        </div>
                                    </MudDragHandle>
                                </div>

                                @if (context.AbsoluteUri is not null)
                                {
                                    <MudImage Src="@context.AbsoluteUri.ToString()"
                                              Alt="@_recipe.Name"
                                              Class="rounded-lg"
                                              Style="object-fit: cover; width: 100%; height: 220px;"/>
                                }

                                <div class="d-flex justify-end mt-3">
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               StartIcon="@HomeBookIcons.Icons8.Windows11.Outline.Trash"
                                               Class="rounded-pill px-4"
                                               Style="backdrop-filter: blur(10px);"
                                               OnClick="@(() => RemoveRecipeImage(context.Id))">
                                        @Loc["RecipeEdit_ImageGallery_RemoveButton_Text"]
                                    </MudButton>
                                </div>

                            </MudPaper>

                        </div>

                    </ItemRenderer>

                </MudDropContainer>
            }

        </MudPaper>

        <MudPaper Class="frosted-b4 text-dark mb-5">

            <MudText Typo="Typo.h5"
                     Class="mx-5 my-3">
                @Loc[nameof(Resources.Strings.RecipeEdit_DurationAdditionalArea_Title)]
            </MudText>

            <MudPaper Class="frosted-b4 text-dark mx-3 mb-5">

                <MudGrid Class="mb-3">

                    <MudItem sm="12" md="6">

                        <MudText Typo="Typo.h6"
                                 Class="mx-3">
                            @Loc[nameof(Resources.Strings.RecipeEdit_WorkingTime_Content)]
                        </MudText>

                        <div class="d-flex align-center justify-space-between flex-grow-1 gap-3 mx-3">
                            <MudNumericField T="int"
                                             Margin="Margin.Dense"
                                             Variant="Variant.Outlined"
                                             Step="1"
                                             Min="0"
                                             Value="@GetDurationHours(_recipe.DurationWorkingMinutes)"
                                             ValueChanged="SetWorkingHours"
                                             Adornment="Adornment.End"
                                             AdornmentText="@Loc[nameof(Resources.Strings.RecipeEdit_WorkingTimeHour_AdornmentText)]"
                                             AdornmentColor="Color.Primary"/>
                            <MudNumericField T="int"
                                             Margin="Margin.Dense"
                                             Variant="Variant.Outlined"
                                             Step="1"
                                             Min="0"
                                             Max="59"
                                             Value="@GetDurationMinutes(_recipe.DurationWorkingMinutes)"
                                             ValueChanged="SetWorkingMinutes"
                                             Adornment="Adornment.End"
                                             AdornmentText="@Loc[nameof(Resources.Strings.RecipeEdit_WorkingTimeMinute_AdornmentText)]"
                                             AdornmentColor="Color.Primary"/>
                        </div>

                    </MudItem>

                    <MudItem sm="12" md="6">

                        <MudText Typo="Typo.h6"
                                 Class="mx-3">
                            @Loc[nameof(Resources.Strings.RecipeEdit_CookingBakingTime_Content)]
                        </MudText>

                        <div class="d-flex align-center justify-space-between flex-grow-1 gap-3 mx-3">
                            <MudNumericField T="int"
                                             Margin="Margin.Dense"
                                             Variant="Variant.Outlined"
                                             Step="1"
                                             Min="0"
                                             Value="@GetDurationHours(_recipe.DurationCookingMinutes)"
                                             ValueChanged="SetCookingHours"
                                             Adornment="Adornment.End"
                                             AdornmentText="@Loc[nameof(Resources.Strings.RecipeEdit_CookingBakingTimeHour_AdornmentText)]"
                                             AdornmentColor="Color.Primary"/>
                            <MudNumericField T="int"
                                             Margin="Margin.Dense"
                                             Variant="Variant.Outlined"
                                             Step="1"
                                             Min="0"
                                             Max="59"
                                             Value="@GetDurationMinutes(_recipe.DurationCookingMinutes)"
                                             ValueChanged="SetCookingMinutes"
                                             Adornment="Adornment.End"
                                             AdornmentText="@Loc[nameof(Resources.Strings.RecipeEdit_CookingBakingTimeMinute_AdornmentText)]"
                                             AdornmentColor="Color.Primary"/>
                        </div>
                    </MudItem>

                    <MudItem sm="12" md="6">

                        <MudText Typo="Typo.h6"
                                 Class="mx-3">
                            @Loc[nameof(Resources.Strings.RecipeEdit_RestingTime_Content)]
                        </MudText>

                        <div class="d-flex align-center justify-space-between flex-grow-1 gap-3 mx-3">
                            <MudNumericField T="int"
                                             Margin="Margin.Dense"
                                             Variant="Variant.Outlined"
                                             Step="1"
                                             Min="0"
                                             Value="@GetDurationHours(_recipe.DurationRestingMinutes)"
                                             ValueChanged="SetRestingHours"
                                             Adornment="Adornment.End"
                                             AdornmentText="@Loc[nameof(Resources.Strings.RecipeEdit_RestingTimeHour_AdornmentText)]"
                                             AdornmentColor="Color.Primary"/>
                            <MudNumericField T="int"
                                             Margin="Margin.Dense"
                                             Variant="Variant.Outlined"
                                             Step="1"
                                             Min="0"
                                             Max="59"
                                             Value="@GetDurationMinutes(_recipe.DurationRestingMinutes)"
                                             ValueChanged="SetRestingMinutes"
                                             Adornment="Adornment.End"
                                             AdornmentText="@Loc[nameof(Resources.Strings.RecipeEdit_RestingTimeMinute_AdornmentText)]"
                                             AdornmentColor="Color.Primary"/>
                        </div>
                    </MudItem>

                    <MudItem sm="12" md="6">

                        <MudText Typo="Typo.h6"
                                 Class="mx-3">
                            @Loc[nameof(Resources.Strings.RecipeEdit_CaloriesPerServing_Content)]
                        </MudText>

                        <div class="d-flex align-center justify-space-between flex-grow-1 gap-3 mx-3">
                            <MudNumericField T="int?"
                                             Margin="Margin.Dense"
                                             Variant="Variant.Outlined"
                                             Step="1"
                                             Min="0"
                                             @bind-Value="@_recipe.CaloriesKcal"
                                             Adornment="Adornment.End"
                                             AdornmentText="@Loc[nameof(Resources.Strings.RecipeEdit_CaloriesPerServing_AdornmentText)]"
                                             AdornmentColor="Color.Primary"/>
                        </div>
                    </MudItem>

                </MudGrid>

            </MudPaper>

            <MudPaper Class="frosted-b4 text-dark mx-3 mb-5">

                <MudText Typo="Typo.h6"
                         Class="mx-3">
                    @Loc[nameof(Resources.Strings.RecipeEdit_RecipeComment_Content)]
                </MudText>

                <MudTextField T="string"
                              Class="mx-3"
                              Lines="5"
                              @bind-Value="@_recipe.Comments"
                              Margin="Margin.Dense"
                              Variant="Variant.Outlined"/>

                <MudText Typo="Typo.h6"
                         Class="mx-3">
                    @Loc[nameof(Resources.Strings.RecipeEdit_RecipeSource_Content)]
                </MudText>

                <MudTextField T="string"
                              Class="mx-3 mb-3"
                              @bind-Value="@_recipe.Source"
                              Margin="Margin.Dense"
                              Variant="Variant.Outlined"/>

            </MudPaper>

        </MudPaper>

        <MudPaper Class="frosted-b4 text-dark mb-5 pa-3">

            <div class="d-flex align-center justify-space-between flex-grow-1 gap-3">

                <MudSpacer/>

                <MudButton Color="Color.Primary"
                           Disabled="_isUploadingImage"
                           Variant="Variant.Filled"
                           OnClick="SaveRecipeAsync">
                    @Loc[nameof(Resources.Strings.RecipeEdit_SaveRecipeButton_Content)]
                </MudButton>

            </div>
        </MudPaper>

    </MudContainer>
}

<MudContainer>

    @if (_isLoading)
    {
        <div class="d-flex justify-center">
            <MudProgressCircular Color="Color.Primary"
                                 Indeterminate="true"/>
        </div>
    }

    @if (!_isLoading)
    {
    }

</MudContainer>

<style>
    .recipe-edit-image-drop-zone {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        min-height: 16rem;
        padding: 0.25rem;
        align-items: stretch;
    }

    .recipe-edit-image-drop-zone > .mud-drop-item,
    .recipe-edit-image-drop-zone > .mud-drop-item-preview-start {
        flex: 0 0 100%;
        width: 100%;
        max-width: 100%;
        box-sizing: border-box;
    }

    @@media (min-width: 600px) {
        .recipe-edit-image-drop-zone > .mud-drop-item,
        .recipe-edit-image-drop-zone > .mud-drop-item-preview-start {
            flex-basis: calc(50% - 0.5rem);
            max-width: calc(50% - 0.5rem);
        }
    }

    @@media (min-width: 960px) {
        .recipe-edit-image-drop-zone > .mud-drop-item,
        .recipe-edit-image-drop-zone > .mud-drop-item-preview-start {
            flex-basis: calc(33.333% - 0.667rem);
            max-width: calc(33.333% - 0.667rem);
        }
    }

    @@media (min-width: 1280px) {
        .recipe-edit-image-drop-zone > .mud-drop-item,
        .recipe-edit-image-drop-zone > .mud-drop-item-preview-start {
            flex-basis: calc(25% - 0.75rem);
            max-width: calc(25% - 0.75rem);
        }
    }

    .recipe-edit-image-card-slot {
        width: 100%;
    }

    .recipe-edit-image-card {
        height: 100%;
        box-shadow: 0 18px 34px rgba(15, 23, 42, 0.12);
    }

    .recipe-edit-image-order-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 3rem;
        padding: 0.35rem 0.85rem;
        border-radius: 999px;
        background: rgba(25, 118, 210, 0.14);
        color: rgb(25, 118, 210);
        font-weight: 700;
        letter-spacing: 0.02em;
    }

    .recipe-edit-image-drag-handle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.75rem;
        height: 2.75rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.72);
        border: 1px solid rgba(25, 118, 210, 0.18);
        cursor: grab;
        transition: transform 0.18s ease, box-shadow 0.18s ease;
    }

    .recipe-edit-image-drag-handle:hover {
        transform: translateY(-1px);
        box-shadow: 0 12px 24px rgba(15, 23, 42, 0.12);
    }

    .recipe-edit-image-drop-zone-dragging {
        border-radius: 1rem;
        background: rgba(25, 118, 210, 0.06);
    }

    .recipe-edit-image-card-dragging {
        opacity: 0.75;
        transform: rotate(-1.25deg) scale(0.98) !important;
    }
</style>
