@page "/Kitchen/Recipes"

@using HomeBook.Frontend.Core.Icons
@using HomeBook.Frontend.Module.Kitchen.Contracts
@using HomeBook.Frontend.Module.Kitchen.Resources
@using HomeBook.Frontend.Module.Kitchen.ViewModels
@using HomeBook.Frontend.Modules.Abstractions
@using Humanizer
@using Microsoft.Extensions.Localization

@inject IRecipeService RecipeService
@inject IStringLocalizer<Strings> Loc
@inject IMediaService MediaService

<MudContainer>

    <MudPaper Class="frosted-b6 text-dark mb-5 pa-3 rounded-pill">

        <MudButton Href="/Kitchen/Recipes/New"
                   Variant="Variant.Filled"
                   Color="Color.Primary">
            +Neues Rezept
        </MudButton>

        <MudButton OnClick="CreateRecipeAsync"
                   Variant="Variant.Outlined"
                   Color="Color.Primary"
                   Class="ms-2">
            +Create Test Recipe
        </MudButton>

    </MudPaper>

</MudContainer>

<MudContainer>

    @if (_isLoading)
    {
        <div class="d-flex justify-center">
            <MudProgressCircular Color="Color.Primary"
                                 Indeterminate="true"/>
        </div>
    }

    @if (!_isLoading)
    {
        <MudGrid>

            @foreach (RecipeViewModel recipe in _recipes)
            {
                <MudItem xs="12" sm="6" md="6" lg="4" xl="4" xxl="4">

                    <MudButton Href="@string.Format("/Kitchen/Recipes/{0}/View", recipe.Id)"
                               FullWidth="true"
                               Class="pa-0"
                               Variant="Variant.Text">

                        <MudCard Class="mud-width-full frosted-b1 border-0">

                            @if (recipe.HeroImageUri is not null)
                            {
                                <MudCardMedia Image="@recipe.HeroImageUri.ToString()"
                                              Height="200"/>
                            }

                            <MudCardContent Class="frosted-b4 border-0">
                                <MudText Typo="Typo.h6">@recipe.Name</MudText>
                                @if (!string.IsNullOrEmpty(recipe.Description))
                                {
                                    <MudText Typo="Typo.body2">@recipe.Description</MudText>
                                }
                            </MudCardContent>

                            @if (recipe.HasAnnotations)
                            {
                                <MudCardActions Class="d-flex align-center frosted-b2 border-0">

                                    @if (recipe.Duration is { TotalSeconds: > 0 })
                                    {
                                        <UiIcon IconStyle="UiIconStyle.Plain"
                                                Size="Size.Small"
                                                Class="d-flex me-1"
                                                ColorValue="var(--hb-color-spring)"
                                                Icon="@HomeBookIcons.Icons8.Windows11.Filled.Clock"/>
                                        <MudText Class="d-flex me-5">
                                            @recipe.Duration.Value.Humanize()
                                        </MudText>
                                    }

                                    @if (recipe.Servings is > 0)
                                    {
                                        <UiIcon IconStyle="UiIconStyle.Plain"
                                                Size="Size.Small"
                                                Class="d-flex me-1"
                                                ColorValue="var(--hb-color-jade)"
                                                Icon="@HomeBookIcons.Icons8.Windows11.Filled.People"/>
                                        <MudText Class="d-flex me-5">
                                            @string.Format(@Loc[nameof(Strings.RecipeOverview_AnnotationServings_TextTemplate)], recipe.Servings)
                                        </MudText>
                                    }

                                </MudCardActions>
                            }

                        </MudCard>

                    </MudButton>

                </MudItem>
            }

        </MudGrid>
    }

</MudContainer>
