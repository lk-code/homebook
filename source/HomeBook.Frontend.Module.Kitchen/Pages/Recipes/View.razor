@page "/Kitchen/Recipes/{RecipeId:guid}/View"

@using HomeBook.Frontend.Core.Icons
@using HomeBook.Frontend.Module.Kitchen.Contracts
@using HomeBook.Frontend.Module.Kitchen.Pages.Recipes.Components
@using HomeBook.Frontend.Modules.Abstractions
@using Humanizer

@inject IRecipeService RecipeService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IMediaService MediaService

@if (!_isLoading
     && _recipeVM != null)
{
    <MudContainer>

        <MudPaper Class="frosted-b6 text-dark mb-5 pa-3 rounded-pill">

            <MudToolBar Dense="true"
                        Class="px-0">

                <MudTooltip Color="Color.Primary"
                            Text="+Edit Recipe">
                    <MudIconButton Icon="@HomeBookIcons.Icons8.Windows11.Outline.Edit"
                                   Href="@string.Format("/Kitchen/Recipes/{0}/Edit", RecipeId)"
                                   Color="Color.Primary"/>
                </MudTooltip>

                <MudSpacer/>

                <MudText Typo="Typo.h5">
                    @_recipeVM.Name
                </MudText>

                <MudSpacer/>

                <MudTooltip Color="Color.Error"
                            Text="+Delete Recipe">
                    <MudIconButton Icon="@HomeBookIcons.Icons8.Windows11.Outline.Trash"
                                   OnClick="DeleteRecipe"
                                   Color="Color.Error"/>
                </MudTooltip>

            </MudToolBar>

        </MudPaper>

        <MudGrid Class="mb-5">

            @if (_recipeVM.HeroImageUri is not null)
            {
                <MudItem xs="12" md="5">
                    <MudCard Class="frosted-b1 border-0">
                        <MudImage Src="@_recipeVM.HeroImageUri.ToString()"
                                  Alt="@_recipeVM.Name"
                                  Class="rounded"/>
                    </MudCard>
                </MudItem>
            }


            <MudItem xs="12" md="7">
                <MudPaper Class="frosted-b8 text-dark pa-3">
                    @if (!string.IsNullOrWhiteSpace(_recipeVM.Description))
                    {
                        <MudText Typo="Typo.body1">@_recipeVM.Description</MudText>
                    }

                    <MudGrid Class="mt-3">
                        @if (_recipeVM.Duration is not null)
                        {
                            <MudItem xs="12" sm="6">
                                <MudText Typo="Typo.h6">+Gesamtdauer</MudText>
                                <MudText Typo="Typo.body2">@_recipeVM.Duration.Value.Humanize()</MudText>
                            </MudItem>
                        }
                        @if (_recipeVM.NumberOfServings > 0)
                        {
                            <MudItem xs="12" sm="6">
                                <MudText Typo="Typo.h6">+Portionen</MudText>
                                <MudText Typo="Typo.body2">@_recipeVM.NumberOfServings</MudText>
                            </MudItem>
                        }
                        @if (_recipeVM.CaloriesKcal is > 0)
                        {
                            <MudItem xs="12" sm="6">
                                <MudText Typo="Typo.h6">+Kalorien/Portion</MudText>
                                <MudText Typo="Typo.body2">@_recipeVM.CaloriesKcal</MudText>
                            </MudItem>
                        }
                    </MudGrid>

                    <MudGrid Class="mt-3">
                        @if (_recipeVM.DurationWorkingMinutes is not null)
                        {
                            <MudItem xs="12" sm="6">
                                <MudText Typo="Typo.h6">+Arbeitszeit</MudText>
                                <MudText Typo="Typo.body2">@_recipeVM.DurationWorkingMinutes.Value.Humanize()</MudText>
                            </MudItem>
                        }
                        @if (_recipeVM.DurationCookingMinutes is not null)
                        {
                            <MudItem xs="12" sm="6">
                                <MudText Typo="Typo.h6">+Koch/Backzeit</MudText>
                                <MudText Typo="Typo.body2">@_recipeVM.DurationCookingMinutes.Value.Humanize()</MudText>
                            </MudItem>
                        }
                        @if (_recipeVM.DurationRestingMinutes is not null)
                        {
                            <MudItem xs="12" sm="6">
                                <MudText Typo="Typo.h6">+Ruhezeit</MudText>
                                <MudText Typo="Typo.body2">@_recipeVM.DurationRestingMinutes.Value.Humanize()</MudText>
                            </MudItem>
                        }
                    </MudGrid>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudPaper Class="frosted-b8 text-dark mb-5">
            <UiRecipeIngredientsList Ingredients="@_recipeVM.Ingredients"
                                     ReadOnly="true"/>
        </MudPaper>

        <MudPaper Class="frosted-b8 text-dark mb-5">
            <UiRecipeStepsList Steps="@_recipeVM.Steps"
                               ReadOnly="true"/>
        </MudPaper>

        @if (!string.IsNullOrWhiteSpace(_recipeVM.Comments)
             || !string.IsNullOrWhiteSpace(_recipeVM.Source))
        {
            <MudPaper Class="frosted-b4 text-dark mb-5 pa-3">
                @if (!string.IsNullOrWhiteSpace(_recipeVM.Comments))
                {
                    <MudText Typo="Typo.h6">+Kommentar</MudText>
                    <MudText Typo="Typo.body2" Class="mb-3">@_recipeVM.Comments</MudText>
                }
                @if (!string.IsNullOrWhiteSpace(_recipeVM.Source))
                {
                    <MudText Typo="Typo.h6">+Quelle</MudText>
                    <MudText Typo="Typo.body2">@_recipeVM.Source</MudText>
                }
            </MudPaper>
        }

    </MudContainer>
}

<MudContainer>

    @if (_isLoading)
    {
        <div class="d-flex justify-center">
            <MudProgressCircular Color="Color.Primary"
                                 Indeterminate="true"/>
        </div>
    }

    @if (!_isLoading)
    {
    }

</MudContainer>
