@using HomeBook.Frontend.Abstractions.Contracts
@using HomeBook.Frontend.Abstractions.Enums
@using HomeBook.Frontend.Abstractions.Models
@using HomeBook.Frontend.Core.Icons
@using HomeBook.Frontend.Modules.Abstractions
@using HomeBook.Frontend.Themes
@using HomeBook.Frontend.UI.Resources
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization

@inherits LayoutComponentBase
@implements IDisposable

@inject IStringLocalizer<LocalizationStrings> Loc
@inject IAuthenticationService AuthenticationService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IJsLocalStorageProvider JsLocalStorageProvider
@inject IMenuService MenuService
@inject IUserPreferencesProvider UserPreferencesProvider
@inject IAppUriProvider AppUriProvider
@inject IMediaService MediaService

@* Required *@
<MudThemeProvider @bind-IsDarkMode="@_isThemeDarkMode"
                  Theme="HomebookTheme.GetTheme()"/>
<MudPopoverProvider/>

@* Needed for dialogs *@
<MudDialogProvider/>

@* Needed for snackbars *@
<MudSnackbarProvider/>

@if (_wallpaperType is not null)
{
    @switch (_wallpaperType)
    {
        case WallpaperType.Static:
        {
            <div class="ui-wallpaper"
                 style="background-image: url('@_wallpaperUri'); ">
            </div>
        }
            break;
        case WallpaperType.Dynamic:
        {
        }
            break;
        case WallpaperType.Uploaded:
        {
            <div class="ui-wallpaper"
                 style="background-image: url('@_wallpaperUri'); ">
            </div>
        }
            break;
    }
}

<MudLayout>

    <MudAppBar Color="Color.Surface"
               Elevation="5"
               Class="hb-header-appbar frosted-b6 text-dark">

        <MudHidden Breakpoint="Breakpoint.MdAndUp">
            <MudIconButton Icon="@HomeBookIcons.Icons8.Windows11.Outline.Menu"
                           Color="Color.Inherit"
                           Edge="Edge.Start"
                           OnClick="@ToggleDrawer"/>

            <MudText Typo="Typo.h5"
                     Class="ml-3">
                @(_homebookInstanceName + " - " + Loc[nameof(LocalizationStrings.AppTitle)])
            </MudText>
        </MudHidden>

        <MudIconButton Icon="@HomeBookIcons.Icons8.Windows11.Outline.Home"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       Href="/"/>

        <MudSpacer/>

        <UiSearchComponent Placeholder="@Loc[nameof(LocalizationStrings.MainLayout_SearchTextField_Placeholder)]"
                           DebounceDelayMs="1000"/>

        <MudSpacer/>

        <AuthorizeView>

            <Authorized>

                <MudMenu Dense
                         Icon="@HomeBookIcons.Icons8.Windows11.Outline.Profile"
                         Color="Color.Inherit">

                    <MudMenuItem Icon="@HomeBookIcons.Icons8.Windows11.Filled.User"
                                 IconColor="Color.Primary"
                                 Label="@context.User.Identity?.Name"/>

                    <MudDivider/>

                    <MudMenuItem Icon="@HomeBookIcons.Icons8.Windows11.Filled.LogoutRounded"
                                 IconColor="Color.Primary"
                                 OnClick="HandleLogoutAsync"
                                 Label="@Loc[nameof(LocalizationStrings.AccountMenu_Logout)]"/>

                </MudMenu>

                <MudHidden Breakpoint="Breakpoint.MdAndUp">
                    <MudMenu Dense
                             Variant="Variant.Text"
                             Size="Size.Medium"
                             Color="Color.Inherit"
                             Icon="@HomeBookIcons.Icons8.Windows11.Outline.More">

                        <MudMenuItem Icon="@HomeBookIcons.Icons8.Windows11.Filled.Gear"
                                     IconColor="Color.Primary"
                                     Href="/Settings"
                                     Label="@Loc[nameof(LocalizationStrings.AccountMenu_Settings)]"/>
                    </MudMenu>
                </MudHidden>

            </Authorized>

            <NotAuthorized>
                <MudIconButton Icon="@HomeBookIcons.Icons8.Windows11.Filled.LoginRounded"
                               Color="Color.Inherit"
                               Edge="Edge.End"
                               OnClick="NavigateToLogin"/>
            </NotAuthorized>

        </AuthorizeView>

    </MudAppBar>

    <MudDrawer Variant="DrawerVariant.Responsive"
               @bind-Open="_drawerOpen"
               Color="Color.Primary"
               Class="hb-drawer"
               Elevation="5">

        <MudDrawerHeader>

            <div class="d-flex flex-column">

                <MudText Typo="Typo.h5" Class="d-block mt-1">
                    @Loc[nameof(LocalizationStrings.AppTitle)]
                </MudText>

                <MudText Typo="Typo.overline" Class="d-block mt-1">
                    @_homebookInstanceName
                </MudText>

            </div>

        </MudDrawerHeader>

        <MudNavMenu Color="Color.Inherit">

            <MudNavLink Match="NavLinkMatch.All"
                        Class="rounded"
                        Icon="@HomeBookIcons.Icons8.Windows11.Outline.Home"
                        IconColor="Color.Inherit"
                        Href="/">
                @Loc[nameof(LocalizationStrings.Home_PageTitle)]
            </MudNavLink>

        </MudNavMenu>

        @if (_hasContextMenuItems)
        {
            <MudDivider Class="flex-grow-0 my-5"
                        DividerType="DividerType.Middle"/>

            <MudNavMenu Color="Color.Inherit">
                @foreach (MenuItem menuItem in _contextMenuItems)
                {
                    <MudNavLink Match="NavLinkMatch.All"
                                Class="rounded"
                                IconColor="Color.Inherit"
                                Icon="@menuItem.Icon"
                                Href="@menuItem.Url">
                        @menuItem.Title
                    </MudNavLink>
                }
            </MudNavMenu>
        }

        <MudSpacer/>

        <MudNavMenu Color="Color.Inherit">

            <MudNavLink Match="NavLinkMatch.All"
                        Class="rounded"
                        Icon="@HomeBookIcons.Icons8.Windows11.Outline.Gear"
                        IconColor="Color.Inherit"
                        Href="/Settings">
                @Loc[nameof(LocalizationStrings.AccountMenu_Settings)]
            </MudNavLink>

        </MudNavMenu>

    </MudDrawer>

    <MudMainContent Class="hb-main-content my-4">
        @Body
    </MudMainContent>

    <MudAppBar Bottom="true"
               Color="Color.Surface"
               Elevation="5"
               Class="hb-footer-appbar frosted-b6 text-dark">

        <MudText Class="me-5" Typo="Typo.caption">@Loc[nameof(LocalizationStrings.AppTitle)]</MudText>
        <MudText Typo="Typo.caption" Class="me-1">@Loc[nameof(LocalizationStrings.AuthorMadeWithText)]</MudText>
        <MudLink Href="@Loc[nameof(LocalizationStrings.AuthorLink)]"
                 Target="_blank"
                 Color="Color.Inherit"
                 Typo="Typo.caption">
            <MudText Typo="Typo.caption">@Loc[nameof(LocalizationStrings.AuthorName)]</MudText>
        </MudLink>

    </MudAppBar>

</MudLayout>

@code {
    private bool _isThemeDarkMode = false;
    private bool _drawerOpen = true;
    private string? _homebookInstanceName = null;
    private bool _hasContextMenuItems = false;
    private MenuItem[] _contextMenuItems = [];
    private WallpaperType? _wallpaperType = null;
    private Uri? _wallpaperUri = null;

    protected override async Task OnInitializedAsync()
    {
        MenuService.OnMenuItemsChanged += MenuServiceOnOnMenuItemsChanged;
        CancellationToken cancellationToken = CancellationToken.None;
        _homebookInstanceName = await JsLocalStorageProvider.GetItemAsync(JsLocalStorageKeys.HomeBookInstanceName,
            cancellationToken);

        UserPreferencesProvider.WallpaperChanged += OnWallpaperChanged;
        AuthenticationService.AuthenticationStateChanged += AuthenticationServiceOnAuthenticationStateChanged;

        if (await AuthenticationService.IsAuthenticatedAsync(cancellationToken))
        {
            await LoadWallpaperAsync(cancellationToken);
        }

        await base.OnInitializedAsync();
    }

    private async Task AuthenticationServiceOnAuthenticationStateChanged(bool isAuthenticated,
        CancellationToken cancellationToken)
    {
        if (isAuthenticated)
        {
            await LoadWallpaperAsync(cancellationToken);
        }
    }

    private async Task OnWallpaperChanged(WallpaperConfiguration wpConfig,
        CancellationToken cancellationToken)
    {
        await LoadWallpaperAsync(cancellationToken);
    }

    private async Task LoadWallpaperAsync(CancellationToken cancellationToken)
    {
        WallpaperConfiguration? wpConfig = await UserPreferencesProvider.GetWallpaperAsync(cancellationToken);
        if (wpConfig is null)
            return;

        await RenderWallpaperAsync(wpConfig, cancellationToken);
    }

    private async Task RenderWallpaperAsync(WallpaperConfiguration wpConfig,
        CancellationToken cancellationToken)
    {
        if (cancellationToken.IsCancellationRequested)
            return;

        string wallpaperEndpoint = "/system/wallpaper";
        _wallpaperType = wpConfig.Type;

        switch (wpConfig.Type)
        {
            case WallpaperType.Static:
            {
                if (wpConfig.ThemeConfiguration is null)
                {
                    // is not a theme
                    string escapedWallpaperName = Uri.EscapeDataString(wpConfig.StaticWallpaperUrl)
                        .Replace(".", "%2E");
                    Uri absoluteWallpaperUri = AppUriProvider
                        .GetAbsoluteUri($"{wallpaperEndpoint}/{escapedWallpaperName}");

                    _wallpaperUri = absoluteWallpaperUri;
                }
                else
                {
                    // wallpaper has theme configuration

                    // TODO: add config support like light, dark, etc.

                    string wallpaperImage = wpConfig.ThemeConfiguration.First().Value.First();
                    string escapedWallpaperName = Uri.EscapeDataString(wallpaperImage)
                        .Replace(".", "%2E");
                    Uri absoluteWallpaperUri = AppUriProvider
                        .GetAbsoluteUri($"{wallpaperEndpoint}/{escapedWallpaperName}");

                    _wallpaperUri = absoluteWallpaperUri;
                }
            }
                break;
            case WallpaperType.Dynamic:
            {
            }
                break;
            case WallpaperType.Uploaded:
            {
                Guid mediaId = wpConfig.MediaId!.Value;
                Uri? absoluteUri = await MediaService.GetUrlForMediaItemAsync(mediaId,
                    cancellationToken);
                _wallpaperUri = absoluteUri;
            }
                break;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleLogoutAsync()
    {
        try
        {
            await AuthenticationService.LogoutAsync();
            Snackbar.Add(Loc[nameof(LocalizationStrings.Logout_SuccessMessage)], Severity.Success);
            NavigationManager.NavigateTo("/Login");
        }
        catch
        {
            Snackbar.Add(Loc[nameof(LocalizationStrings.Logout_ErrorMessage)], Severity.Error);
        }
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void NavigateToLogin()
    {
        NavigationManager.NavigateTo("/Login");
    }

    private void MenuServiceOnOnMenuItemsChanged(object? sender, EventArgs e)
    {
        _contextMenuItems = MenuService.GetMenuItems();
        _hasContextMenuItems = _contextMenuItems.Length > 0;

        StateHasChanged();
    }

    public void Dispose()
    {
        MenuService.OnMenuItemsChanged -= MenuServiceOnOnMenuItemsChanged;
        UserPreferencesProvider.WallpaperChanged -= OnWallpaperChanged;
    }

}
