@using HomeBook.Frontend.Abstractions.Models
@using HomeBook.Frontend.Core.Icons
@using HomeBook.Frontend.Modules.Abstractions
@using Microsoft.AspNetCore.Components

@inject IEnumerable<ISearchHandlerResultTemplate> SearchHandlerResultTemplates
@inject IEnumerable<SearchHandlerResultTemplateRegistration> SearchHandlerResultTemplateRegistrations

<div class="@RootCssClass">
    <MudTextField T="string"
                  Value="@SearchText"
                  ValueChanged="OnSearchTextChangedAsync"
                  Margin="Margin.Dense"
                  Placeholder="@Placeholder"
                  Clearable="true"
                  Immediate="true"
                  FullWidth="true"
                  Variant="Variant.Outlined"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@HomeBookIcons.Icons8.Windows11.Outline.Search"
                  Class="ui-search-component__input"/>

    <MudDialog Visible="@ShowFlyout"
               VisibleChanged="OnDialogVisibleChanged"
               Options="@SearchDialogOptions"
               Gutters="false"
               Class="frosted-b3"
               ContentClass="ui-search-component__dialog-content">
        <DialogContent>
            <div class="ui-search-component__dialog-body">
            @if (IsSearching)
            {
                <div class="ui-search-component__state">
                    <MudProgressCircular Indeterminate="true"
                                         Size="Size.Small"/>
                </div>
            }
            else
            {
                @foreach (SearchModuleGroup module in SearchResults)
                {
                    <section class="ui-search-component__module" @key="module.ModuleKey">
                        <div class="ui-search-component__module-header">
                            <MudText Typo="Typo.overline"
                                     Class="ui-search-component__module-title">
                                @FormatModuleName(module.ModuleKey)
                            </MudText>

                            <MudText Typo="Typo.caption"
                                     Class="ui-search-component__module-count">
                                @module.TotalCount
                            </MudText>
                        </div>

                        @if (module.TemplateType is not null)
                        {
                            <DynamicComponent Type="module.TemplateType"
                                              Parameters="BuildSearchHandlerResultTemplateParameters(module.Items)"/>
                        }
                        else
                        {
                            <div class="ui-search-component__items">
                                @foreach (SearchHandlerResultTemplateItem item in module.Items)
                                {
                                    <div class="ui-search-component__item"
                                         @key="item.Identifier ?? item.Title">
                                        <MudText Typo="Typo.body2"
                                                 Class="ui-search-component__item-title">
                                            @item.Title
                                        </MudText>

                                        @if (!string.IsNullOrWhiteSpace(item.Description))
                                        {
                                            <MudText Typo="Typo.caption"
                                                     Class="ui-search-component__item-description">
                                                @item.Description
                                            </MudText>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </section>
                }
            }
            </div>
        </DialogContent>
    </MudDialog>
</div>
