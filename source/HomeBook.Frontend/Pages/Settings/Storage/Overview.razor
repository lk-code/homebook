@page "/Settings/Storage"

@using HomeBook.Frontend.Abstractions.Contracts
@using HomeBook.Frontend.Core.Icons
@using HomeBook.Frontend.UI.Resources
@using HomeBook.Frontend.ViewModels.Settings.Storage
@using Microsoft.Extensions.Localization

@inject IStringLocalizer<LocalizationStrings> Loc
@inject ISystemStorageProvider SystemStorageProvider

<MudContainer>

    <MudGrid>

        <MudItem xs="12" sm="12" md="4" lg="3" xl="3" xxl="3">

            <SettingsNavMenu/>

        </MudItem>

        <MudItem xs="12" sm="12" md="8" lg="9" xl="9" xxl="9">

            <!-- Application Information -->
            <MudPaper Class="pa-6 frosted-b8"
                      Elevation="2">

                <MudStack Row="true"
                          Class="align-center mb-1"
                          Spacing="2">
                    <MudIcon Icon="@HomeBookIcons.Icons8.GlassMorphism.DoughnutChart"
                             Size="Size.Large"
                             Class="mr-2"/>
                    <MudText Typo="Typo.h5"
                             Color="Color.Primary">
                        @Loc[nameof(LocalizationStrings.Settings_Storage_StorageInformationsArea_Title)]
                    </MudText>
                </MudStack>

                <MudDivider Class="mb-4"/>

                <MudStack Spacing="2">

                    <MudChart ChartType="ChartType.Pie"
                              T="double"
                              @bind-SelectedIndex="_selectedStorageSegmentIndex"
                              Width="100%"
                              Height="140px"
                              LegendPosition="Position.End"
                              ChartSeries="@_storageUsageSeries"
                              ChartLabels="@_storageUsageLabels"/>

                </MudStack>

                @if (_storageEntries.Any())
                {
                    <MudStack Class="mt-5"
                              Spacing="2">

                        <MudList T="string">

                            @foreach (StorageEntryViewModel se in _storageEntries)
                            {
                                @if (!se.SubEntries.Any())
                                {
                                    <MudListItem Class="py-0"
                                                 Text="@string.Format($"{se.Title} - {se.UsageSizeFormatted}")"/>
                                }
                                else
                                {
                                    <MudListItem Class="py-0"
                                                 Text="@string.Format($"{se.Title} - {se.UsageSizeFormatted}")"
                                                 ExpandIconColor="Color.Transparent"
                                                 Expanded>

                                        <NestedList>

                                            @foreach (StorageEntryViewModel seLevel2 in se.SubEntries)
                                            {
                                                <MudListItem Class="py-0"
                                                             Text="@string.Format($"{seLevel2.Title} - {seLevel2.UsageSizeFormatted}")"
                                                             ExpandIconColor="Color.Transparent"
                                                             Expanded>

                                                    <NestedList>

                                                        @foreach (StorageEntryViewModel seLevel3 in seLevel2.SubEntries)
                                                        {
                                                            <MudListItem Class="py-0 ps-13"
                                                                         Text="@string.Format($"{seLevel3.Title} - {seLevel3.UsageSizeFormatted}")"/>
                                                        }

                                                    </NestedList>

                                                </MudListItem>
                                            }

                                        </NestedList>

                                    </MudListItem>
                                }
                            }

                        </MudList>

                    </MudStack>
                }

            </MudPaper>

        </MudItem>

    </MudGrid>

</MudContainer>
